# LOCAL DEVELOPMENT ONLY.
# Copy to the repository root as .env: cp configs/arima.env.example .env
# Never use these sample passwords or sslmode=disable in staging/production.

COMPOSE_PROJECT_NAME=arima
POSTGRES_DB=arima_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_PORT=5432

# Created by scripts/postgres/grant-runtime-roles.sql after migrations.
ARIMA_API_DB_PASSWORD=local-api-password
ARIMA_OUTBOX_DB_PASSWORD=local-outbox-password
ARIMA_DATABASE_URL=postgres://arima_api:local-api-password@database:5432/arima_dev?sslmode=disable
ARIMA_OUTBOX_DATABASE_URL=postgres://arima_outbox:local-outbox-password@database:5432/arima_dev?sslmode=disable

# API listener and validated HTTP timeouts.
ARIMA_ENV=development
ARIMA_ADDR=:8080
ARIMA_HTTP_PORT=8080
ARIMA_READ_HEADER_TIMEOUT=5s
ARIMA_READ_TIMEOUT=15s
ARIMA_WRITE_TIMEOUT=15s
ARIMA_IDLE_TIMEOUT=60s

# Optional development OIDC provider. Leave both empty to keep protected routes fail-closed.
ARIMA_OIDC_ISSUER=
ARIMA_OIDC_AUDIENCE=

# Optional outbox worker profile. Set both values to a real HTTPS receiver
# that durably accepts events and deduplicates by event ID before starting it.
ARIMA_OUTBOX_HEALTH_PORT=8081
ARIMA_OUTBOX_HEALTH_ADDR=:8081
ARIMA_OUTBOX_WEBHOOK_URL=
ARIMA_OUTBOX_WEBHOOK_TOKEN=

# Staging/production values belong in the hosting provider's secret manager,
# not in this local file. Production requires:
# ARIMA_ENV=production
# ARIMA_OIDC_ISSUER=https://your-real-issuer/
# ARIMA_OIDC_AUDIENCE=your-api-audience
# ARIMA_DATABASE_URL=postgres://...?...sslmode=verify-full
# ARIMA_OUTBOX_DATABASE_URL=postgres://...?...sslmode=verify-full
# ARIMA_OUTBOX_WEBHOOK_URL=https://your-durable-event-receiver/
# ARIMA_OUTBOX_WEBHOOK_TOKEN=<managed secret>
