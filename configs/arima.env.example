# Copy the required values into your deployment environment.
# This example contains no credentials or tenant data.
# ARIMA_ADDR must be host:port or :port. Default: :8080
ARIMA_ADDR=:8080

# Positive Go durations; each must be <= 5m.
# Defaults are intentionally conservative for a synchronous HTTP API.
ARIMA_READ_HEADER_TIMEOUT=5s
ARIMA_READ_TIMEOUT=15s
ARIMA_WRITE_TIMEOUT=15s
ARIMA_IDLE_TIMEOUT=60s
