# Copy values into the deployment environment; never commit real secrets.
ARIMA_ENV=development

# HTTP listener and timeouts.
ARIMA_ADDR=:8080
ARIMA_READ_HEADER_TIMEOUT=5s
ARIMA_READ_TIMEOUT=15s
ARIMA_WRITE_TIMEOUT=15s
ARIMA_IDLE_TIMEOUT=60s

# OIDC JWT validation. Configure BOTH values or leave BOTH unset outside production.
# Provider discovery URL is derived from the issuer's OIDC discovery document.
# The provider must publish HTTPS metadata and a rotating JWKS endpoint.
# ARIMA_OIDC_ISSUER=https://identity.example.com/
# ARIMA_OIDC_AUDIENCE=arima-api

# The verified access token must contain a non-empty tenant_id claim.
# ARIMA_ENV=production requires the OIDC values and fails startup if provider discovery fails.
