# Copy required values into your deployment environment.
# Never commit real secrets or this file with real credentials.
# HTTP listener: host:port or :port. Default :8080.
ARIMA_ADDR=:8080

# Positive Go durations, each <= 5m.
ARIMA_READ_HEADER_TIMEOUT=5s
ARIMA_READ_TIMEOUT=15s
ARIMA_WRITE_TIMEOUT=15s
ARIMA_IDLE_TIMEOUT=60s

# Optional OAuth 2.0 token introspection configuration.
# Configure ALL five values or leave ALL unset.
# The endpoint must be HTTPS and return RFC 7662 introspection JSON with
# active, iss, aud, exp, sub and tenant_id claims.
# ARIMA_OIDC_INTROSPECTION_URL=https://identity.example.com/oauth2/introspect
# ARIMA_OIDC_ISSUER=https://identity.example.com/
# ARIMA_OIDC_AUDIENCE=arima-api
# ARIMA_OIDC_CLIENT_ID=arima-api-introspection
# Supply ARIMA_OIDC_CLIENT_SECRET through the secret manager/environment only.
